__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# ─────────────────────────────────────────────────────────
# Environment
# ─────────────────────────────────────────────────────────
.env
.venv/
venv/
env/
*.env

